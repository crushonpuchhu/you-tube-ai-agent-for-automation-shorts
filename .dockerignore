# --- Secrets: must never be baked into the image ---------------------------
.env
.env.*
!.env.example
auth/*.json

# --- Python caches ---------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Virtual environments --------------------------------------------------
.venv/
venv/
env/

# --- Version control -------------------------------------------------------
.git/
.gitignore

# --- Runtime data: lives in a Docker volume, not the image ------------------
# config.py creates data/ and auth/ itself at import time, so the image only
# needs the empty directories (made in the Dockerfile) with the right owner.
data/videos/
data/logs/
data/tokens/
data/*.db
data/*.db-*
*.db
*.db-wal
*.db-shm
# The cookie jar is a live YouTube login credential. Excluding it keeps a
# (soon stale) jar from being baked into any image; a fresh one can only ever
# reach the container through the data/ volume mount or /autopilot_cookies.
data/cookies.txt
data/cookies.txt.tmp
# Owner-provided source media and their rights sidecars are runtime data.
data/autonomous_sources/

# --- Local editor / tooling noise ------------------------------------------
.vscode/
.idea/
*.log

# Browser snapshots recorded while driving the Google Cloud console setup
# assistant. Session artefacts, never application code.
.playwright-mcp/
