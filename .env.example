# ---- Telegram ----
# 1. Talk to @BotFather on Telegram -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyzghtyexample
# Optional: run your own local Bot API server to lift the 20 MB download limit
# e.g. TELEGRAM_LOCAL_API_URL=http://localhost:8081
TELEGRAM_LOCAL_API_URL=
# Optional: fixed chat for background notifications (otherwise the first chat
# that talks to the bot is remembered automatically)
TELEGRAM_CHAT_ID=

# ---- Google Gemini (video analysis + research brain) ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Stronger fallback (also free-tier): gemini-3.8-flash

# ---- YouTube (OAuth) ----
# Path to the OAuth "Desktop app" client secret you downloaded from Google Cloud
YOUTUBE_CLIENT_SECRET=auth/client_secret.json
YOUTUBE_TOKEN_FILE=data/tokens/youtube_token.json
# 23=Comedy 24=Entertainment 26=Howto & Style 27=Education 22=People & Blogs 28=Science & Technology 17=Sports 1=Music
YOUTUBE_DEFAULT_CATEGORY_ID=24
# private | unlisted | public
YOUTUBE_DEFAULT_PRIVACY=public

# ---- Storage ----
MAX_VIDEO_MB=20
# Storage hygiene: delete each local copy right after YouTube confirms the upload.
# The DB record (title, link, stats) is kept — only the video bytes are removed.
DELETE_AFTER_UPLOAD=true
# Daily sweep also removes downloads older than this many days (orphans,
# permanently failed uploads). 0 = delete finished videos immediately.
VIDEO_RETENTION_DAYS=3
# SQLite database location. Default is ~/.shorts-agent/agent.db because SQLite
# locking is unreliable on NTFS/exFAT/FUSE mounts (e.g. /media/... drives).
# Set this only if your project drive is a native Linux filesystem — and keep it
# commented out for Docker: compose already points the container at
# /app/db/agent.db, which is bind-mounted to ~/.shorts-agent/agent.db (the
# default below), so host and container share ONE database.
# Relative paths (e.g. data/agent.db) resolve against the project folder on the
# host and against /app inside the container.
#AGENT_DB_PATH=/media/mittal/New Volume/ai agents/you tube shorts automation ai agent/data/agent.db

# ---- Daily goal & reminders (IST) ----
DAILY_SHORT_GOAL=2
# Comma-separated 24h IST times to nag you if you are behind
GOAL_REMINDER_TIMES=20:30,22:30
# Minimum spacing between two Shorts (helps the daily target stay realistic)
MIN_GAP_BETWEEN_SHORTS_HOURS=4
# Don't schedule a slot closer than this to "now"
MIN_LEAD_MINUTES=30

# ---- Scheduling engine ----
# Hours of YouTube Analytics history needed before we trust our own data;
# before that, general India/IST research windows are used (and labelled as such)
ANALYTICS_SYNC_HOURS=6

# ---- Weekly report (IST) ----
WEEKLY_REPORT_ENABLED=true
# 0=Monday ... 6=Sunday
WEEKLY_REPORT_WEEKDAY=0
WEEKLY_REPORT_HOUR=20
WEEKLY_REPORT_MINUTE=0

# ---- Content research (AI) ----
RESEARCH_ENABLED=true
# Hour of day (IST) the daily research run is allowed to start
RESEARCH_HOUR=10
# What this channel is about (drives topic research + recommendations)
CHANNEL_NICHE=coding tips, tech setup, AI tools, productivity
# Source switches (be polite: these run once per research run)
RESEARCH_YOUTUBE=true
RESEARCH_NEWS=true
RESEARCH_REDDIT=true

# ---- Scheduler ----
# How often the background worker checks for due tasks (seconds)
SCHEDULER_TICK_SECONDS=30

# ---- Terminal UI ----
# Live dashboard (goal, queue, live events) when run in an interactive terminal.
# Set to false to get the plain scrolling log instead (e.g. under systemd/CI).
TERMINAL_UI=false

# ---- Docker ----
# docker-compose.yml mounts host folders into the container so nothing is lost
# when the container is stopped, rebuilt, removed or recreated:
#   ./data                  -> /app/data   (YouTube token, logs, videos)
#   ~/.shorts-agent         -> /app/db     (SQLite agent.db — same file local runs use)
#   ./auth                  -> /app/auth   (OAuth client secret, read-only)
# It also forces AGENT_DB_PATH=/app/db/agent.db inside the container (so a
# host-style path from this file can never spawn a second empty database) and
# runs as RUN_UID:RUN_GID:
#RUN_UID=1000   # your `id -u`
#RUN_GID=1000   # your `id -g`
# Note: the YouTube token is reused from the host — run the one-time
# `python scripts/youtube_auth.py` OUTSIDE Docker; the container refreshes the
# access token silently. IN_DOCKER=1 (set by compose) disables the browser
# consent flow inside the container on purpose.
#
# Plain `docker run` users: pass the same mounts and let AGENT_DB_PATH use the
# image default, e.g.
#   docker run -d --env-file .env -u "$(id -u):$(id -g)" \
#     -v "$PWD/data:/app/data" -v "$HOME/.shorts-agent:/app/db" \
#     -v "$PWD/auth:/app/auth:ro" shorts-agent:latest
# Do NOT uncomment AGENT_DB_PATH here for Docker runs: a host path would be
# created INSIDE the container (startup then refuses to run and tells you why).
