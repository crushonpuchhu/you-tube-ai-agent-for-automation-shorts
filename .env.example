# ---- Telegram ----
# 1. Talk to @BotFather on Telegram -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyzghtyexample
# Optional: run your own local Bot API server to lift the 20 MB download limit
# e.g. TELEGRAM_LOCAL_API_URL=http://localhost:8081
TELEGRAM_LOCAL_API_URL=
# Optional: fixed chat for background notifications (otherwise the first chat
# that talks to the bot is remembered automatically)
TELEGRAM_CHAT_ID=

# ---- Google Gemini (video analysis + research brain) ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Stronger fallback (also free-tier): gemini-3.8-flash

# ---- YouTube (OAuth) ----
# Path to the OAuth "Desktop app" client secret you downloaded from Google Cloud
YOUTUBE_CLIENT_SECRET=auth/client_secret.json
YOUTUBE_TOKEN_FILE=data/tokens/youtube_token.json
# 23=Comedy 24=Entertainment 26=Howto & Style 27=Education 22=People & Blogs 28=Science & Technology 17=Sports 1=Music
YOUTUBE_DEFAULT_CATEGORY_ID=24
# private | unlisted | public
YOUTUBE_DEFAULT_PRIVACY=public
# Refresh the access token this many minutes BEFORE it expires, so a long
# upload never dies on a token that ran out mid-transfer (Google tokens live ~1h).
YOUTUBE_REFRESH_LEEWAY_MINUTES=10

# ---- Text overlay (FFmpeg drawtext) ----
# Burn a one-line caption onto the Short before uploading. Requires FFmpeg
# (baked into the Docker image; on a host run `apt-get install ffmpeg`).
TEXT_OVERLAY_ENABLED=true
# How long the bot waits for a caption pick before continuing WITHOUT an overlay
CAPTION_TIMEOUT_MINUTES=15
# Only set these if ffmpeg/ffprobe are NOT on PATH:
#FFMPEG_PATH=/usr/bin/ffmpeg
#FFPROBE_PATH=/usr/bin/ffprobe
# Optional custom TrueType font for the overlay (default: DejaVu Sans Bold):
#OVERLAY_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ---- Storage ----
MAX_VIDEO_MB=20
# Storage hygiene: delete each local copy right after YouTube confirms the upload.
# The DB record (title, link, stats) is kept — only the video bytes are removed.
DELETE_AFTER_UPLOAD=true
# Daily sweep also removes downloads older than this many days (orphans,
# permanently failed uploads). 0 = delete finished videos immediately.
VIDEO_RETENTION_DAYS=3
# SQLite database location. Default is ~/.shorts-agent/agent.db because SQLite
# locking is unreliable on NTFS/exFAT/FUSE mounts (e.g. /media/... drives).
# Set this only if your project drive is a native Linux filesystem — and keep it
# commented out for Docker: compose already points the container at
# /app/db/agent.db, which is bind-mounted to ~/.shorts-agent/agent.db (the
# default below), so host and container share ONE database.
# Relative paths (e.g. data/agent.db) resolve against the project folder on the
# host and against /app inside the container.
#AGENT_DB_PATH=/media/mittal/New Volume/ai agents/you tube shorts automation ai agent/data/agent.db

# ---- Daily goal & reminders (IST) ----
DAILY_SHORT_GOAL=2
# Comma-separated 24h IST times to nag you if you are behind
GOAL_REMINDER_TIMES=20:30,22:30
# Minimum spacing between two Shorts (helps the daily target stay realistic)
MIN_GAP_BETWEEN_SHORTS_HOURS=4
# Don't schedule a slot closer than this to "now"
MIN_LEAD_MINUTES=30

# ---- Scheduling engine ----
# Hours of YouTube Analytics history needed before we trust our own data;
# before that, general India/IST research windows are used (and labelled as such)
ANALYTICS_SYNC_HOURS=6

# ---- Weekly report (IST) ----
WEEKLY_REPORT_ENABLED=true
# 0=Monday ... 6=Sunday
WEEKLY_REPORT_WEEKDAY=0
WEEKLY_REPORT_HOUR=20
WEEKLY_REPORT_MINUTE=0

# ---- Content research (AI) ----
RESEARCH_ENABLED=true
# Hour of day (IST) the daily research run is allowed to start
RESEARCH_HOUR=10
# What this channel is about (drives topic research + recommendations)
CHANNEL_NICHE=coding tips, tech setup, AI tools, productivity
# Source switches (be polite: these run once per research run)
RESEARCH_YOUTUBE=true
RESEARCH_NEWS=true
RESEARCH_REDDIT=true

# ---- Scheduler ----
# How often the background worker checks for due tasks (seconds)
SCHEDULER_TICK_SECONDS=30

# ---- Terminal UI ----
# Live dashboard (goal, queue, live events) when run in an interactive terminal.
# Set to false to get the plain scrolling log instead (e.g. under systemd/CI).
TERMINAL_UI=false

# ---- Docker ----
# docker-compose.yml mounts host folders into the container so nothing is lost
# when the container is stopped, rebuilt, removed or recreated:
#   ./data                  -> /app/data   (YouTube token, logs, videos)
#   ~/.shorts-agent         -> /app/db     (SQLite agent.db — same file local runs use)
#   ./auth                  -> /app/auth   (OAuth client secret, read-only)
# It also forces AGENT_DB_PATH=/app/db/agent.db inside the container (so a
# host-style path from this file can never spawn a second empty database) and
# runs as RUN_UID:RUN_GID:
#RUN_UID=1000   # your `id -u`
#RUN_GID=1000   # your `id -g`
# Note: the YouTube token is reused from the host — run the one-time
# `python scripts/youtube_auth.py` OUTSIDE Docker; the container refreshes the
# access token silently. IN_DOCKER=1 (set by compose) disables the browser
# consent flow inside the container on purpose.
#
# Plain `docker run` users: pass the same mounts and let AGENT_DB_PATH use the
# image default, e.g.
#   docker run -d --env-file .env -u "$(id -u):$(id -g)" \
#     -v "$PWD/data:/app/data" -v "$HOME/.shorts-agent:/app/db" \
#     -v "$PWD/auth:/app/auth:ro" shorts-agent:latest
# Do NOT uncomment AGENT_DB_PATH here for Docker runs: a host path would be
# created INSIDE the container (startup then refuses to run and tells you why).

# [AUTONOMOUS-FITNESS-V2] ---- Autonomous content workflow (spec v4) ----
# EVERYTHING BELOW IS ADDITIVE AND OFF BY DEFAULT. With these lines left as-is
# the agent behaves exactly like before: same commands, same OAuth scopes, same
# database tables, same scheduler tasks, same approval/upload/cleanup flow.
#
# Turn the feature on in two steps:
#   1) ENABLE_AUTONOMOUS_CONTENT=true          (generation + /autopilot_* tools)
#   2) ENABLE_AUTONOMOUS_SCHEDULER=true        (queue cycles at PUBLISH_TIMES_IST)
# Leaving (2) false still lets you run a cycle manually with /autopilot_run.
ENABLE_AUTONOMOUS_CONTENT=false
ENABLE_AUTONOMOUS_SCHEDULER=false
# Publishing without a human tap. Requires ENABLE_AUTONOMOUS_CONTENT=true AND a
# verified source-rights basis for every clip. Keep false for owner review.
ENABLE_UNATTENDED_PUBLISH=false
# Reserved capability switches from the spec (currently reported, not used to
# bypass any rights/approval rule).
ENABLE_TRENDS=false
ENABLE_HIGHLIGHTS=false
ENABLE_NL_AGENT=false
# Search YouTube for long-form source candidates. Search is NOT permission to
# reuse: every candidate still has to pass the source-rights gate below.
YOUTUBE_DISCOVERY_ENABLED=false

# ---- Niche / channel ----
# The active niche is stored durably in SQLite and survives restarts/rebuilds.
# CHANNEL_NICHE (above) is only the bootstrap default until /autopilot_niche is
# used. A Telegram change overrides it from the next cycle onward; it never
# rewrites already queued or scheduled videos.
CHANNEL_LANGUAGE=Hindi
CHANNEL_REGION=IN
CONTENT_MIX=70% trending, 30% evergreen educational

# ---- Publishing slots (IST, HH:MM, comma-separated) ----
# Cycles are queued this many minutes before each slot so review can happen.
SHORTS_PER_DAY=2
PUBLISH_TIMES_IST=06:30,22:00
AUTONOMOUS_PUBLISH_LEAD_MINUTES=90
BOT_TIMEZONE=Asia/Kolkata
# Recurring-cycle single-flight lock (protects against overlapping runs).
AUTONOMOUS_CYCLE_LOCK_TTL_MINUTES=180

# ---- Research / long-form discovery ----
RESEARCH_LOOKBACK_HOURS=72
# Google News + Google Trends RSS topic search (keyless). Off = use only the
# existing research engine.
RESEARCH_USE_GOOGLE_SEARCH=true
AUTONOMOUS_MAX_TOPICS_PER_CYCLE=3
YOUTUBE_SEARCH_RESULTS_PER_TOPIC=10
# Licence class requested from YouTube search. "creativeCommon" makes
# discovery return only CC-licensed videos, which the rights gate can verify
# without owner input. "any" searches every licence (most results are then
# rejected by the gate, and each search costs 100 quota units).
YOUTUBE_SEARCH_LICENSE=creativeCommon
# publishedAfter window for SOURCE search (0 = no date filter). Long-form
# sources are evergreen, so this is separate from RESEARCH_LOOKBACK_HOURS.
YOUTUBE_SOURCE_LOOKBACK_HOURS=0
YOUTUBE_MIN_SOURCE_VIDEO_MINUTES=5
MAX_SOURCE_VIDEO_MINUTES=120
YOUTUBE_SOURCE_DEDUPLICATION=true

# ---- Clip rendering ----
MAX_CLIPS_PER_SOURCE=5
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=55
# How a landscape source becomes a 9:16 Short.
#   fit  = whole frame stays visible, empty sides filled with a blurred copy (default)
#   crop = zoom until it fills 9:16, which cuts the left/right edges off
SHORTS_VERTICAL_MODE=fit
# Burn the clip's own hook line onto the video (more engagement on Shorts).
AUTONOMOUS_BURN_CAPTION=true
# top | center | bottom
AUTONOMOUS_CAPTION_POSITION=bottom

# ---- Daily quotas and safety limits ----
MAX_DAILY_SOURCE_DOWNLOADS=5
MAX_DAILY_GEMINI_ANALYSES=10
MAX_DAILY_GENERATED_SHORTS=4
MAX_CONCURRENT_SOURCE_JOBS=1
MIN_DISK_SPACE_MULTIPLIER=2.0

# ---- Source rights (HARD GATE) ----
# A clip is only downloaded/processed/published when one of these holds:
#   * owner media with a *.rights.json sidecar containing "confirmed": true
#   * explicit creator permission recorded by the owner
#   * the creator/channel appears in SOURCE_ALLOWLIST
#   * YouTube reports the video under a Creative Commons licence
# Public visibility, search ranking and owner approval are NOT permission.
# Comma-separated channels, channel ids or URLs (case-insensitive).
SOURCE_ALLOWLIST=
# Remote downloads stay disabled unless you explicitly opt in. Owner media in
# AUTONOMOUS_SOURCE_DIR never needs downloading.
AUTONOMOUS_ALLOW_DOWNLOAD=false
# Folder scanned for owner-provided long-form media + rights sidecars.
# Default: <project>/data/autonomous_sources (inside the ./data volume).
#AUTONOMOUS_SOURCE_DIR=/app/data/autonomous_sources

# ---- yt-dlp download hardening (datacenter IPs) ----
# The agent downloads from a cloud IP, where YouTube blocks automated requests
# with "Sign in to confirm you're not a bot" unless all three are in place:
# a signed-in cookie jar (see /autopilot_cookies), Proof-of-Origin tokens
# (minted automatically via the bgutil provider inside the image) and a
# browser-like TLS fingerprint. Tune only when troubleshooting.
# Browser impersonation target for yt-dlp (curl_cffi). "off" disables it.
YTDLP_IMPERSONATE=chrome
# Seconds to wait between HTTP requests yt-dlp makes during an extraction.
YTDLP_SLEEP_REQUESTS=1.0
# Optional: comma-separated player clients (e.g. "mweb,web_safari"). Empty =
# let yt-dlp choose the best clients for the current YouTube state.
YTDLP_PLAYER_CLIENT=
# Where the bgutil PO-token provider script lives inside the image.
YTDLP_POT_SERVER_HOME=/opt/bgutil/server
# Where the signed-in cookie jar is read from. Default: data/cookies.txt.
#YTDLP_COOKIEFILE=/app/data/cookies.txt

# ---- Approval / ownership ----
# true = every generated Short waits for Approve/Schedule/Retry/Discard.
OWNER_REVIEW_MODE=true
AUTO_PUBLISH_REQUIRES_LICENSE_CHECK=true
# Optional extra Telegram user ids allowed to run /autopilot_* (comma-separated).
# When empty the existing TELEGRAM_CHAT_ID / persisted owner_chat_id is used.
AUTOPILOT_OWNER_IDS=
